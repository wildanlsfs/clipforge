# Copy to .env for local docker-compose runs. On Coolify, set these as
# the app's Environment Variables instead (do NOT commit a real .env).

# --- LLM (any OpenAI-compatible endpoint: 9router, OpenRouter, Groq, etc.) ---
# Leave both blank to run with the free built-in heuristic scorer (no LLM, $0).
LLM_BASE_URL=https://your-9router-endpoint/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- yt-dlp cookies (usually required on a VPS/cloud server) ---
# YouTube frequently blocks unauthenticated downloads from datacenter IPs
# with "Sign in to confirm you're not a bot" -- confirmed happening on a
# real Coolify VPS deploy even though the exact same code worked fine from
# a residential IP.
#
# Each person using the app can (and should) paste their own cookies.txt
# directly in the UI ("Your YouTube cookies" under the form) -- that's
# stored in their browser only and sent per-request, never saved server-
# side, so multiple people sharing one instance each authenticate as
# themselves. This env var is just the server-wide FALLBACK for anyone who
# doesn't set their own. Paste the full contents of a Netscape-format
# cookies.txt export here (e.g. from the "Get cookies.txt LOCALLY" Chrome
# extension, exported while logged into youtube.com in your own browser).
# Leave blank to require every user to supply their own.
YTDLP_COOKIES=

# --- yt-dlp proxy ---
# Cookies alone don't beat every "Sign in to confirm you're not a bot"
# block -- confirmed live that a valid, logged-in cookie session still
# gets blocked 100% of the time from a flagged VPS/datacenter IP while
# working fine from a residential one. If that's happening on every
# video (not just specific ones), route yt-dlp's traffic through a
# residential/mobile proxy or a tunnel back to a home connection here.
# Any scheme yt-dlp's --proxy accepts, e.g.:
#   YTDLP_PROXY=http://user:pass@proxy-host:port
#   YTDLP_PROXY=socks5://localhost:1080
# Leave blank (default) to skip proxying -- most setups won't need this
# unless downloads fail on literally every video.
YTDLP_PROXY=

# --- yt-dlp PO token provider ---
# YouTube increasingly requires a PO (Proof-of-Origin) token to hand back
# real video/audio formats at all -- without one, some player clients
# silently return storyboard-only formats instead of erroring, and no
# amount of cookies/client-spoofing fixes that. docker-compose.yml runs
# the token server as its own `pot-provider` service already; this only
# needs setting if you're overriding its address (e.g. running the
# provider elsewhere, or on bare metal without compose's internal DNS).
# Leave unset to use the default (http://pot-provider:4416), or set to
# empty to disable PO-token support entirely.
POT_PROVIDER_URL=

# --- whisper (local transcription, always free) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- clip tuning ---
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=90
MAX_CLIPS_PER_VIDEO=6

CORS_ORIGINS=*

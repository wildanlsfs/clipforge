# Copy to .env for local docker-compose runs. On Coolify, set these as
# the app's Environment Variables instead (do NOT commit a real .env).

# --- LLM (any OpenAI-compatible endpoint: 9router, OpenRouter, Groq, etc.) ---
# Leave both blank to run with the free built-in heuristic scorer (no LLM, $0).
LLM_BASE_URL=https://your-9router-endpoint/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- whisper (local transcription, always free) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- clip tuning ---
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=90
MAX_CLIPS_PER_VIDEO=6

CORS_ORIGINS=*
